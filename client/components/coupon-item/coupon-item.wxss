.coupon-item {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  min-width: 600rpx;
  margin: 0 30rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.coupon-left {
  width: 160rpx;
  background: #07C160;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

.coupon-left::after {
  content: '';
  position: absolute;
  right: -12rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 24rpx;
  height: 24rpx;
  background: #f5f5f5;
  border-radius: 50%;
}

.coupon-discount {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.coupon-center {
  flex: 1;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.coupon-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.coupon-condition {
  font-size: 22rpx;
  color: #999999;
  margin-top: 6rpx;
}

.coupon-expire {
  font-size: 20rpx;
  color: #cccccc;
  margin-top: 4rpx;
}

.coupon-right {
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.coupon-btn {
  font-size: 26rpx;
  color: #07C160;
  padding: 12rpx 24rpx;
  border: 1rpx solid #07C160;
  border-radius: 30rpx;
}

.coupon-btn:active {
  opacity: 0.7;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
  margin-top: 24rpx;
}

.empty-btn {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: #07C160;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  line-height: 1;
  text-align: center;
}

.empty-btn::after {
  border: none;
}

.empty-btn:active {
  opacity: 0.8;
}

.home-nav {
  display: flex;
  justify-content: flex-start;
  padding: 16rpx 20rpx 0;
}

.nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-btn-hover {
  opacity: 0.8;
}

.hospital-card {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 30rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.hospital-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.hospital-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.hospital-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.4;
}

.hospital-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  line-height: 1.4;
}

.tag.level {
  background: #e8f8ee;
  color: #07C160;
}

.tag.score {
  background: #fff8e6;
  color: #ff9500;
}

.hospital-address {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hospital-distance {
  font-size: 22rpx;
  color: #07C160;
  margin-top: 6rpx;
}

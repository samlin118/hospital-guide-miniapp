.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: #ffffff;
  border-bottom: 1rpx solid #f5f5f5;
}

.nav-bar-inner {
  display: flex;
  align-items: center;
  height: 44px;
  padding: 0 16rpx;
}

.nav-back {
  width: 72rpx;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 24px;
  height: 24px;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 500;
  color: #333333;
}

.nav-right {
  width: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

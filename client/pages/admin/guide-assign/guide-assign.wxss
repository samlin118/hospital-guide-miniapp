.admin-page { padding: 30rpx; background: var(--bg-primary); min-height: 100vh; }
.form-section { background: #fff; border-radius: var(--card-radius); padding: 30rpx; margin-bottom: 30rpx; box-shadow: var(--shadow-sm); }
.form-item { margin-bottom: 28rpx; }
.form-label { font-size: 26rpx; color: var(--text-primary); display: block; margin-bottom: 12rpx; font-weight: 500; }
.picker-value { height: 80rpx; line-height: 80rpx; background: var(--bg-primary); border-radius: var(--radius-md); padding: 0 24rpx; font-size: 26rpx; color: var(--text-primary); }
.dept-check-list { max-height: 480rpx; overflow-y: auto; }
.dept-check-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid var(--divider); }
.dept-check-item:last-child { border-bottom: none; }
.check-box { width: 36rpx; height: 36rpx; border-radius: 8rpx; border: 2rpx solid #ccc; margin-right: 20rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; flex-shrink: 0; }
.check-box.checked { background: #07C160; border-color: #07C160; }
.check-icon { width: 24rpx; height: 24rpx; color: #fff; font-size: 24rpx; line-height: 1; }
.dept-check-name { font-size: 28rpx; color: var(--text-primary); }
.dept-hint { font-size: 24rpx; color: var(--text-hint); }
.submit-btn { width: 100%; height: 88rpx; background: linear-gradient(135deg, #07C160, #06AD56); color: #fff; border-radius: var(--radius-md); font-size: 30rpx; display: flex; align-items: center; justify-content: center; margin-top: 20rpx; }
.list-section { background: #fff; border-radius: var(--card-radius); padding: 30rpx; box-shadow: var(--shadow-sm); }
.list-title { font-size: 30rpx; font-weight: bold; color: var(--text-primary); display: block; margin-bottom: 20rpx; }
.assign-group { margin-bottom: 8rpx; }
.assign-row { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid var(--divider); }
.assign-row:last-child { border-bottom: none; }
.assign-hosp { font-size: 26rpx; color: var(--text-secondary); }
.assign-dept { font-size: 26rpx; color: #07C160; font-weight: 500; }

.admin-page { padding: 30rpx; background: var(--bg-primary); min-height: 100vh; }
.price-tip { font-size: 24rpx; color: var(--text-hint); margin-bottom: 20rpx; }
.guide-list { background: #fff; border-radius: var(--card-radius); padding: 10rpx 30rpx; box-shadow: var(--shadow-sm); }
.guide-item { display: flex; align-items: center; padding: 26rpx 0; border-bottom: 1rpx solid var(--divider); }
.guide-item:last-child { border-bottom: none; }
.guide-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #F2F3F5; margin-right: 22rpx; flex-shrink: 0; }
.guide-info { flex: 1; }
.guide-name { font-size: 30rpx; font-weight: bold; color: var(--text-primary); display: block; }
.guide-phone { font-size: 24rpx; color: var(--text-hint); display: block; margin-top: 6rpx; }
.guide-price-wrap { text-align: right; flex-shrink: 0; }
.guide-price { font-size: 32rpx; color: var(--primary); font-weight: bold; }
.unit { font-size: 22rpx; color: var(--text-hint); font-weight: normal; }
.edit-hint { font-size: 22rpx; color: #07C160; display: block; margin-top: 4rpx; }

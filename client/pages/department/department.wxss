.dept-page { padding-bottom: 20rpx; }
.hospital-info { background: #fff; margin: 20rpx 30rpx; border-radius: var(--card-radius); padding: 30rpx; }
.hosp-name { font-size: 32rpx; font-weight: bold; display: block; margin-bottom: 8rpx; }
.hosp-addr { font-size: 26rpx; color: var(--text-hint); }
.dept-list { margin: 0 30rpx; background: #fff; border-radius: var(--card-radius); overflow: hidden; }
.dept-item { display: flex; align-items: center; padding: 30rpx; border-bottom: 1rpx solid #f0f0f0; }
.dept-item:last-child { border-bottom: none; }
.dept-left { display: flex; align-items: center; flex: 1; }
.dept-icon { width: 40rpx; height: 40rpx; margin-right: 20rpx; }
.dept-name { font-size: 28rpx; color: var(--text-primary); }
.dept-desc { font-size: 24rpx; color: var(--text-hint); margin: 0 20rpx; flex: 1; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dept-arrow { width: 24rpx; height: 24rpx; }
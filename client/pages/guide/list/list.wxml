<view class="guide-list-page">
  <home-nav />
  <view class="filter-bar">
    <text class="filter-item {{sortBy === 'default' ? 'active' : ''}}" bindtap="onSort" data-sort="default">综合排序</text>
    <text class="filter-item {{sortBy === 'score' ? 'active' : ''}}" bindtap="onSort" data-sort="score">评分最高</text>
    <text class="filter-item {{sortBy === 'price' ? 'active' : ''}}" bindtap="onSort" data-sort="price">价格最低</text>
  </view>
  <view class="guide-list">
    <guide-card wx:for="{{guides}}" wx:key="id" 
      id="{{item.id}}" name="{{item.name}}" avatar="{{item.avatar}}"
      score="{{item.score}}" serviceCount="{{item.service_count}}" desc="{{item.desc}}"
      price="{{item.price}}" bind:tap="onGuideTap" />
    <empty-state wx:if="{{guides.length === 0}}" text="暂无导诊员信息" />
  </view>
</view>
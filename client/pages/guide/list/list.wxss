.guide-list-page { padding-bottom: 20rpx; }
.filter-bar { display: flex; gap: 16rpx; margin: 20rpx 30rpx; }
.filter-item { padding: 10rpx 24rpx; border-radius: 30rpx; font-size: 24rpx; background: #f0f0f0; color: var(--text-secondary); }
.filter-item.active { background: var(--primary); color: #fff; }
.guide-list { padding: 0 30rpx; }
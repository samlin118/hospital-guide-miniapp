.patients-page { padding-bottom: 20rpx; }
.page-header { background: #fff; margin: 20rpx 30rpx; border-radius: var(--card-radius); padding: 30rpx; }
.page-title { font-size: 32rpx; font-weight: bold; display: block; margin-bottom: 8rpx; color: var(--text-primary); }
.page-sub { font-size: 26rpx; color: var(--text-hint); }
.order-list { margin: 0 30rpx; background: #fff; border-radius: var(--card-radius); overflow: hidden; }
.order-card { padding: 26rpx 30rpx; border-bottom: 1rpx solid #f0f0f0; }
.order-card:last-child { border-bottom: none; }
.order-top { display: flex; align-items: center; }
.patient-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #F2F3F5; margin-right: 20rpx; flex-shrink: 0; }
.order-patient { flex: 1; }
.patient-name { font-size: 30rpx; font-weight: bold; color: var(--text-primary); display: block; }
.patient-phone { font-size: 24rpx; color: var(--text-hint); display: block; margin-top: 4rpx; }
.order-status { font-size: 26rpx; font-weight: bold; flex-shrink: 0; }
.order-meta { margin-top: 14rpx; background: var(--bg-primary); border-radius: var(--radius-md); padding: 14rpx 20rpx; }
.order-line { font-size: 24rpx; color: var(--text-secondary); display: block; margin-top: 6rpx; }
.order-line:first-child { margin-top: 0; }

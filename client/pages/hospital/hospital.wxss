.hospital-page { padding-bottom: 20rpx; }
.search-box { margin: 20rpx 30rpx; display: flex; align-items: center; gap: 20rpx; }
.search-input { flex: 1; height: 72rpx; background: #fff; border-radius: 36rpx; padding: 0 30rpx; font-size: 28rpx; box-shadow: var(--shadow-sm); }
.search-btn { height: 72rpx; line-height: 72rpx; padding: 0 30rpx; background: var(--primary); color: #fff; border-radius: 36rpx; font-size: 28rpx; border: none; }
.filter-bar { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 0 30rpx 20rpx; }
.filter-item { padding: 10rpx 24rpx; border-radius: 30rpx; font-size: 24rpx; background: #f0f0f0; color: var(--text-secondary); }
.filter-item.active { background: var(--primary); color: #fff; }
.hospital-list { padding: 0 30rpx; }
.index-page { padding-bottom: 20rpx; }
.search-bar { margin: 20rpx 30rpx; height: 72rpx; background: #fff; border-radius: 36rpx; display: flex; align-items: center; padding: 0 30rpx; box-shadow: var(--shadow-sm); }
.search-icon { width: 32rpx; height: 32rpx; margin-right: 16rpx; }
.search-text { color: var(--text-placeholder); font-size: 28rpx; }
.banner { height: 280rpx; margin: 0 30rpx; border-radius: var(--radius-lg); overflow: hidden; }
.banner-image { width: 100%; height: 280rpx; }
.quick-nav { display: flex; flex-wrap: wrap; padding: 30rpx; background: #fff; margin: 20rpx 30rpx; border-radius: var(--card-radius); }
.nav-item { width: 25%; display: flex; flex-direction: column; align-items: center; margin-bottom: 20rpx; }
.nav-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}
.nav-bg-hospital { background: #E8F8EE; }
.nav-bg-guide { background: #E8F4FD; }
.nav-bg-order { background: #FFF3E0; }
.nav-bg-mine { background: #F0E8FD; }
.nav-icon { width: 60rpx; height: 60rpx; }
.nav-text { font-size: 24rpx; color: var(--text-secondary); }
.section { margin: 20rpx 30rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.section-title { font-size: 32rpx; font-weight: bold; }
.section-more { font-size: 24rpx; color: var(--text-hint); }
.hospital-list { }
.guide-scroll { white-space: nowrap; }
.guide-scroll-inner { display: inline-flex; gap: 20rpx; }
.guide-item { width: 200rpx; background: #fff; border-radius: var(--card-radius); padding: 20rpx; display: inline-flex; flex-direction: column; align-items: center; }
.guide-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; margin-bottom: 12rpx; }
.guide-name { font-size: 26rpx; font-weight: bold; }
.guide-score { font-size: 22rpx; color: var(--warning); }
.guide-price { font-size: 24rpx; color: var(--primary); font-weight: bold; margin-top: 4rpx; }
page { background-color: #fff; }
.login-page { padding: 100rpx 60rpx 0; }
.login-header { display: flex; flex-direction: column; align-items: center; margin-bottom: 80rpx; }
.login-logo { width: 120rpx; height: 120rpx; border-radius: 30rpx; margin-bottom: 20rpx; }
.login-title { font-size: 48rpx; font-weight: bold; color: var(--primary); }
.login-desc { font-size: 28rpx; color: var(--text-hint); margin-top: 12rpx; }
.login-role-select { display: flex; justify-content: space-between; margin-bottom: 60rpx; }
.role-card { width: 48%; padding: 40rpx 20rpx; border: 2rpx solid var(--border-color); border-radius: var(--card-radius); display: flex; flex-direction: column; align-items: center; }
.role-card.active { border-color: var(--primary); background: var(--primary-light); }
.role-icon { width: 80rpx; height: 80rpx; margin-bottom: 16rpx; }
.role-name { font-size: 30rpx; font-weight: bold; }
.role-desc { font-size: 22rpx; color: var(--text-hint); margin-top: 8rpx; }
.login-form { }
.login-input { height: 88rpx; border: 2rpx solid var(--border-color); border-radius: var(--radius-md); padding: 0 24rpx; margin-bottom: 24rpx; font-size: 28rpx; }
.login-btn { height: 88rpx; background: var(--primary); color: #fff; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: bold; margin-top: 20rpx; }
.login-links { display: flex; justify-content: space-between; margin-top: 30rpx; }
.link { color: var(--secondary); font-size: 26rpx; }

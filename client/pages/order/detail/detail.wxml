<view class="detail-page">
  <home-nav />
  <view class="status-bar" style="background: {{order.statusColor}}">
    <text class="status-icon">{{order.statusIcon}}</text>
    <text class="status-text">{{order.statusText}}</text>
  </view>

  <view class="section">
    <view class="info-row"><text class="label">订单编号</text><text class="value">{{order.order_no}}</text></view>
    <view class="info-row"><text class="label">导诊员</text><text class="value">{{order.guide_name}}</text></view>
    <view class="info-row"><text class="label">服务医院</text><text class="value">{{order.hospital_name}}</text></view>
    <view class="info-row"><text class="label">服务科室</text><text class="value">{{order.dept_name}}</text></view>
    <view class="info-row"><text class="label">服务日期</text><text class="value">{{order.date}}</text></view>
    <view class="info-row"><text class="label">开始时间</text><text class="value">{{order.start_time}}</text></view>
    <view class="info-row"><text class="label">服务时长</text><text class="value">{{order.duration}}小时</text></view>
  </view>

  <view class="section">
    <view class="info-row"><text class="label">基础费用</text><text class="value">¥{{order.base_amount}}</text></view>
    <view class="info-row" wx:if="{{order.discount_amount > 0}}"><text class="label">优惠减免</text><text class="value discount">-¥{{order.discount_amount}}</text></view>
    <view class="info-row total"><text class="label">实付金额</text><text class="value total-price">¥{{order.final_amount}}</text></view>
    <view class="info-row"><text class="label">支付方式</text><text class="value">{{order.payment_method === 'wechat' ? '微信支付' : '支付宝'}}</text></view>
  </view>

  <view class="bottom-bar" wx:if="{{order.status === 0}}">
    <button class="cancel-btn" bindtap="onCancel">取消订单</button>
    <button class="pay-btn" bindtap="onPay">去支付</button>
  </view>
</view>
<view class="order-list-page">
  <view class="tabs">
    <text class="tab {{currentTab === index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="index" bindtap="onTabChange" data-index="{{index}}">{{item}}</text>
  </view>
  <view class="order-list">
    <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="onOrderTap" data-id="{{item.id}}">
      <view class="order-header">
        <text class="order-no">订单号: {{item.order_no}}</text>
        <text class="order-status" style="color: {{item.statusColor}}">{{item.statusText}}</text>
      </view>
      <view class="order-body">
        <text class="order-guide">导诊员: {{item.guide_name || '未知'}}</text>
        <text class="order-time">{{item.date}} {{item.start_time}} ({{item.duration}}小时)</text>
      </view>
      <view class="order-footer">
        <text class="order-amount">¥{{item.final_amount}}</text>
        <view class="order-actions">
          <button class="action-btn" wx:if="{{item.status === 0}}" bindtap="onPay" data-id="{{item.id}}" catchtap>去支付</button>
          <button class="action-btn" wx:if="{{item.status === 0}}" bindtap="onCancel" data-id="{{item.id}}" catchtap>取消</button>
          <button class="action-btn" wx:if="{{item.status === 3 && !item.isRated}}" bindtap="onRate" data-id="{{item.id}}" catchtap>去评价</button>
        </view>
      </view>
    </view>
    <empty-state wx:if="{{orders.length === 0}}" text="暂无订单" />
  </view>
</view>
.order-list-page { background: var(--bg-color); min-height: 100vh; }
.tabs { display: flex; background: #fff; padding: 0 30rpx; position: sticky; top: 0; z-index: 10; }
.tab { flex: 1; text-align: center; padding: 24rpx 0; font-size: 28rpx; color: var(--text-secondary); position: relative; }
.tab.active { color: var(--primary); font-weight: bold; }
.tab.active::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 40rpx; height: 4rpx; background: var(--primary); border-radius: 2rpx; }
.order-list { padding: 20rpx 30rpx; }
.order-card { background: #fff; border-radius: var(--card-radius); padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); }
.order-header { display: flex; justify-content: space-between; align-items: center; padding-bottom: 16rpx; border-bottom: 1rpx solid var(--divider); }
.order-no { font-size: 24rpx; color: var(--text-hint); }
.order-status { font-size: 26rpx; font-weight: bold; }
.order-body { padding: 16rpx 0; display: flex; flex-direction: column; gap: 8rpx; }
.order-guide { font-size: 28rpx; font-weight: bold; color: var(--text-primary); }
.order-time { font-size: 24rpx; color: var(--text-secondary); }
.order-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 16rpx; border-top: 1rpx solid var(--divider); }
.order-amount { font-size: 36rpx; color: var(--danger); font-weight: bold; }
.order-actions { display: flex; gap: 16rpx; }
.action-btn { height: 56rpx; line-height: 56rpx; padding: 0 24rpx; border: 2rpx solid var(--primary); border-radius: var(--radius-sm); color: var(--primary); font-size: 24rpx; background: #fff; }
.action-btn::after { border: none; }
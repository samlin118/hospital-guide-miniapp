<view class="profile-page">
  <home-nav />
  <view class="user-card">
    <view class="avatar-wrap" bindtap="onAvatarTap">
      <image class="user-avatar" src="{{userInfo.avatar || '/images/default/avatar.png'}}" mode="aspectFill" />
      <view class="avatar-badge">
        <image class="avatar-camera" src="/images/icons/camera.png" />
      </view>
    </view>
    <view class="user-meta">
      <text class="user-name">{{userInfo.name || '未登录'}}</text>
      <text class="user-role">{{roleText}}</text>
    </view>
  </view>

  <view class="order-stats">
    <view class="stat-item" bindtap="onOrderTap" data-status="0">
      <text class="stat-num">{{orderCounts[0]}}</text>
      <text class="stat-label">待支付</text>
    </view>
    <view class="stat-item" bindtap="onOrderTap" data-status="1">
      <text class="stat-num">{{orderCounts[1]}}</text>
      <text class="stat-label">已支付</text>
    </view>
    <view class="stat-item" bindtap="onOrderTap" data-status="3">
      <text class="stat-num">{{orderCounts[3]}}</text>
      <text class="stat-label">已完成</text>
    </view>
    <view class="stat-item" bindtap="onOrderTap" data-status="4">
      <text class="stat-num">{{orderCounts[4]}}</text>
      <text class="stat-label">已取消</text>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="onMyOrders">
      <view class="menu-icon-wrap icon-order">
        <image class="menu-icon" src="/images/icons/order.png" />
      </view>
      <text class="menu-text">我的订单</text>
      <image class="menu-arrow" src="/images/icons/arrow-right.png" />
    </view>
    <view class="menu-item" bindtap="onMyCoupons">
      <view class="menu-icon-wrap icon-coupon">
        <image class="menu-icon" src="/images/icons/coupon.png" />
      </view>
      <text class="menu-text">我的优惠券</text>
      <image class="menu-arrow" src="/images/icons/arrow-right.png" />
    </view>
    <view class="menu-item" bindtap="onMyMessages">
      <view class="menu-icon-wrap icon-message">
        <image class="menu-icon" src="/images/icons/message.png" />
      </view>
      <text class="menu-text">联系客服</text>
      <image class="menu-arrow" src="/images/icons/arrow-right.png" />
    </view>
    <view class="menu-item" wx:if="{{isAdmin}}" bindtap="onAdmin">
      <view class="menu-icon-wrap icon-admin">
        <image class="menu-icon" src="/images/icons/admin.png" />
      </view>
      <text class="menu-text">管理后台</text>
      <image class="menu-arrow" src="/images/icons/arrow-right.png" />
    </view>
  </view>

  <button class="logout-btn" bindtap="onLogout">退出登录</button>
</view>

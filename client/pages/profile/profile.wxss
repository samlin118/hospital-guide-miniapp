.profile-page { padding-bottom: 40rpx; }
.user-card { background: linear-gradient(135deg, #07C160, #06AD56); padding: 60rpx 40rpx; display: flex; align-items: center; }
.avatar-wrap { position: relative; }
.user-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,0.5); }
.avatar-badge {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}
.avatar-camera { width: 32rpx; height: 32rpx; }
.user-meta { margin-left: 24rpx; }
.user-name { font-size: 36rpx; font-weight: bold; color: #fff; }
.user-role { font-size: 24rpx; color: rgba(255,255,255,0.8); margin-top: 8rpx; display: block; }
.order-stats { display: flex; background: #fff; margin: -30rpx 30rpx 20rpx; border-radius: var(--card-radius); padding: 30rpx 0; box-shadow: var(--shadow-md); position: relative; z-index: 1; }
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; border-right: 1rpx solid var(--divider); }
.stat-item:last-child { border-right: none; }
.stat-num { font-size: 36rpx; font-weight: bold; color: var(--text-primary); }
.stat-label { font-size: 22rpx; color: var(--text-hint); margin-top: 8rpx; }
.menu-list { margin: 20rpx 30rpx; background: #fff; border-radius: var(--card-radius); overflow: hidden; }
.menu-item { display: flex; align-items: center; padding: 30rpx 24rpx; border-bottom: 1rpx solid var(--divider); }
.menu-item:last-child { border-bottom: none; }
.menu-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.icon-order { background: #E8F4FD; }
.icon-coupon { background: #E8F8EE; }
.icon-message { background: #FFF3E0; }
.icon-admin { background: #F0E8FD; }

.menu-icon { width: 40rpx; height: 40rpx; }
.menu-text { flex: 1; font-size: 28rpx; }
.menu-arrow { width: 14rpx; height: 24rpx; }
.logout-btn { margin: 60rpx 30rpx 0; height: 88rpx; background: #fff; color: var(--danger); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: 30rpx; border: 2rpx solid var(--danger); }

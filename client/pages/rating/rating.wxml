<view class="rating-page">
  <home-nav />
  <view class="rating-header">
    <text class="header-title">服务评价</text>
    <text class="header-desc">请为本次导诊服务打分</text>
  </view>

  <view class="score-section">
    <text class="score-label">整体评分</text>
    <view class="stars">
      <image class="star" wx:for="{{5}}" wx:key="idx" 
        src="{{idx < score ? '/images/icons/star-active.png' : '/images/icons/star.png'}}"
        bindtap="onStarTap" data-index="{{idx + 1}}" />
    </view>
    <text class="score-text">{{scoreText}}</text>
  </view>

  <view class="content-section">
    <textarea class="content-input" placeholder="分享您的服务体验..." value="{{content}}" bindinput="onContentInput" maxlength="200" />
    <text class="content-count">{{content.length}}/200</text>
  </view>

  <view class="anonymous-section">
    <text class="anonymous-label">匿名评价</text>
    <switch checked="{{anonymous}}" bindchange="onAnonymousChange" color="#07C160" />
  </view>

  <button class="submit-btn" bindtap="onSubmit">提交评价</button>
</view>

.rating-page { padding: 40rpx 30rpx; }
.rating-header { text-align: center; margin-bottom: 60rpx; }
.header-title { font-size: 36rpx; font-weight: bold; }
.header-desc { font-size: 26rpx; color: var(--text-hint); margin-top: 12rpx; }
.score-section { display: flex; flex-direction: column; align-items: center; margin-bottom: 60rpx; }
.score-label { font-size: 28rpx; color: var(--text-secondary); margin-bottom: 20rpx; }
.stars { display: flex; gap: 16rpx; }
.star { width: 60rpx; height: 60rpx; }
.score-text { font-size: 48rpx; font-weight: bold; color: var(--warning); margin-top: 16rpx; }
.content-section { background: #fff; border-radius: var(--card-radius); padding: 24rpx; position: relative; }
.content-input { width: 100%; height: 200rpx; font-size: 28rpx; }
.content-count { position: absolute; bottom: 16rpx; right: 24rpx; font-size: 22rpx; color: var(--text-hint); }
.anonymous-section { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 0; }
.anonymous-label { font-size: 28rpx; }
.submit-btn { height: 88rpx; background: var(--primary); color: #fff; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: bold; margin-top: 40rpx; }

page { background-color: #fff; }
.register-page { padding: 40rpx; }
.register-header { margin-bottom: 60rpx; }
.register-title { font-size: 40rpx; font-weight: bold; color: #333; }
.register-desc { font-size: 26rpx; color: var(--text-hint); margin-top: 12rpx; }
.form-item { margin-bottom: 32rpx; }
.form-label { display: block; font-size: 26rpx; color: #999; margin-bottom: 16rpx; }
.form-input { width: 100%; height: 80rpx; border-bottom: 2rpx solid var(--border-color); font-size: 28rpx; padding: 0 8rpx; }
.submit-btn { height: 88rpx; background: var(--primary); color: #fff; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: bold; margin-top: 60rpx; }
.to-login { display: block; text-align: center; color: var(--text-hint); font-size: 26rpx; margin-top: 30rpx; }

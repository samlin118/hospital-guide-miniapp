<view class="register-page">
  <home-nav />
  <view class="register-header">
    <text class="register-title">患者注册</text>
    <text class="register-desc">填写个人信息完成注册</text>
  </view>
  <view class="avatar-picker" bindtap="onChooseAvatar">
    <image class="avatar-preview" src="{{avatarPreview || '/images/default/avatar.png'}}" mode="aspectFill" />
    <text class="avatar-hint">点击上传头像</text>
  </view>
  <view class="register-form">
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input class="form-input" placeholder="请输入真实姓名" value="{{name}}" bindinput="onInput" data-field="name" />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" placeholder="请输入手机号" type="text" maxlength="11" value="{{phone}}" bindinput="onInput" data-field="phone" />
    </view>
    <view class="form-item">
      <text class="form-label">身份证号</text>
      <input class="form-input" placeholder="请输入身份证号" type="text" maxlength="18" value="{{idCard}}" bindinput="onInput" data-field="idCard" />
    </view>
    <view class="form-item">
      <text class="form-label">家庭住址</text>
      <input class="form-input" placeholder="请输入家庭住址" value="{{address}}" bindinput="onInput" data-field="address" />
    </view>
    <view class="form-item">
      <text class="form-label">设置密码</text>
      <input class="form-input" placeholder="请设置登录密码" type="password" value="{{password}}" bindinput="onInput" data-field="password" />
    </view>
    <button class="submit-btn" bindtap="onRegister">注 册</button>
    <text class="to-login" bindtap="onToLogin">已有账号？去登录</text>
  </view>
</view>
